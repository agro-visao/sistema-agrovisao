# Variáveis de ambiente do backend (Cloudflare Pages Functions)
#
# LOCAL: copie este arquivo para `.dev.vars` e preencha com os valores de
# desenvolvimento (o arquivo `.dev.vars` é ignorado pelo Git).
#
# PRODUÇÃO: use `npx wrangler pages secret put <NOME>` — nunca grave valores
# reais no repositório, no wrangler.toml ou no frontend.

# Envio do e-mail de recuperação de senha (Resend)
RESEND_API_KEY=
MAIL_FROM=

# Upload de imagens dos produtos (Backblaze B2 - bucket privado)
# B2_APPLICATION_KEY_ID: ID da chave de aplicação B2
# B2_APPLICATION_KEY: Chave de aplicação B2 (secreto, nunca expor)
# B2_BUCKET_ID: ID do bucket (ex: 1ffb63ba16e9b69d92f80412)
# B2_BUCKET_NAME: Nome do bucket (ex: agrovisao-vendas)
# Nenhum segredo é exposto no frontend — todos os uploads/downloads passam pelo
# backend autenticado.
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=

# URL pública usada nos links de recuperação enviados por e-mail
# Ex.: https://agrovisaopara.com.br
PUBLIC_SITE_URL=

# Bootstrap do primeiro administrador (somente no primeiro deploy; remover depois)
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Controle de debug (desenvolvimento)
ADMIN_DEBUG_RESET=0
