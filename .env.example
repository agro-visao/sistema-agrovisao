# Variáveis de ambiente do backend (Cloudflare Pages Functions)
#
# LOCAL: copie este arquivo para `.dev.vars` e preencha com os valores de
# desenvolvimento (o arquivo `.dev.vars` é ignorado pelo Git).
#
# PRODUÇÃO: use `npx wrangler pages secret put <NOME>` — nunca grave valores
# reais no repositório, no wrangler.toml ou no frontend.

# Supabase — URL do projeto e chaves de API (Project Settings → API)
SUPABASE_URL=
# Chave publishable/anon: segura para uso no cliente (também usada aqui no
# backend para validar o token de sessão do usuário logado).
SUPABASE_ANON_KEY=
# Chave service_role: acesso total ao banco/storage, ignora RLS. Só existe no
# backend — nunca deve chegar ao frontend nem a logs.
SUPABASE_SERVICE_ROLE_KEY=

# E-mail do administrador único do painel. Usado como verificação extra
# (defesa em profundidade) além da sessão válida do Supabase Auth.
ADMIN_EMAIL=admin@agrovisaopara.com.br

# URL pública usada nos links de recuperação de senha (redirectTo do Supabase
# Auth) e no CORS/Origin dos endpoints públicos.
# Ex.: https://agrovisaopara.com.br
PUBLIC_SITE_URL=

# ───────────────────────────────────────────────────────────────────────────
# Frontend (Vite) — variáveis expostas ao navegador, sempre com prefixo VITE_.
# Copie para `.env.local` (ignorado pelo Git). Use a MESMA URL e a chave
# publishable/anon acima (nunca a service_role aqui).
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
